# Address the login-server advertises to real clients as the game-world host.
# Must be reachable from wherever the Tibia/OTClient runs. 192.168.5.122 is this
# host's LAN IP (matches MYAAC_SITE_URL); use 127.0.0.1 for same-machine only.
CANARY_SERVER_IP=127.0.0.1

# Legacy protocol ports (game-only, default 7174/7175).
CANARY_LEGACY_1100_GAME_PORT=7174
CANARY_LEGACY_860_GAME_PORT=7175

CANARY_DUMP_ITEM_OPCODES=1
